# ===========================================
# Video Encoder Pipeline - .gitignore
# ===========================================

# -------------------------------------------
# Rust
# -------------------------------------------
/target/
**/target/
Cargo.lock
**/*.rs.bk
*.pdb

# -------------------------------------------
# Node.js (AWS CDK)
# -------------------------------------------
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# AWS CDK
cdk/cdk.out/
cdk/node_modules/
*.js.map
*.d.ts

# -------------------------------------------
# Video Files & Outputs
# -------------------------------------------
# Output directory (large encoded files)
/outputs/
/output/

# Source videos (too large for git)
/sources/*.mp4
/sources/*.mkv
/sources/*.avi
/sources/*.mov
/sources/*.webm
!/sources/.gitkeep

# Encoder test videos
encoder/test_videos/

# Player generated content (encoded output)
player/*/
!player/index.html
!player/styles.css
!player/app.js
!player/serve.sh
!player/README.md

# Temporary encoding files
*.tmp
*.temp
/tmp/

# -------------------------------------------
# IDE & Editors
# -------------------------------------------
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# -------------------------------------------
# OS Generated
# -------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# -------------------------------------------
# Security & Secrets
# -------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
key.bin
clearkey_license.json

# AWS credentials (never commit!)
credentials
.aws/

# -------------------------------------------
# Project Specific
# -------------------------------------------
# Memo/scratch files
memo.txt
scratch/
notes/

# MCP server cache
.playwright-mcp/
.serena/

# Claude Code artifacts
claudedocs/

# FFmpeg temporary files
ffmpeg2pass-*
ffprobe_output.json

# -------------------------------------------
# Testing & Coverage
# -------------------------------------------
coverage/
*.lcov
.nyc_output/

# -------------------------------------------
# Build & Distribution
# -------------------------------------------
dist/
build/
*.egg-info/
